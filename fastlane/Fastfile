default_platform(:ios)

ASC_KEY_ID = "BYF7TNAA54"
ASC_ISSUER_ID = "69a6de85-e2c7-47e3-e053-5b8c7c11a4d1"
ASC_KEY_PATH = File.expand_path("~/private_keys/AuthKey_BYF7TNAA54.p8")
SCHEME = "FestivAir"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
    UI.user_error!("ASC key not found at #{ASC_KEY_PATH}") unless File.exist?(ASC_KEY_PATH)
  end

  desc "Build + upload to TestFlight (auto-bumps build number to next available)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      in_house: false
    )

    next_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.festivair.app"
    ) + 1
    increment_build_number(build_number: next_build, xcodeproj: "FestivAir.xcodeproj")

    build_app(
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "./build",
      output_name: "FestivAir.ipa",
      clean: true,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates",
      xcodebuild_formatter: "xcbeautify"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["FASTLANE_CHANGELOG"] || "Internal build #{next_build}"
    )
  end

  desc "Archive only — no upload (for testing the build pipeline)"
  lane :archive_only do
    build_app(
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "./build",
      output_name: "FestivAir.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates",
      xcodebuild_formatter: "xcbeautify",
      skip_package_ipa: false
    )
  end

  desc "Show current TestFlight build number for this app"
  lane :tf_build_number do
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH
    )
    n = latest_testflight_build_number(api_key: api_key, app_identifier: "com.festivair.app")
    UI.success("Latest TestFlight build number: #{n}")
  end
end
